    <name>AgentScope Java - Harness</name>
    <artifactId>agentscope-harness</artifactId>
    <description>AgentScope Harness - Enhanced agent runtime with workspace context, subagent orchestration, memory management, and backend abstraction</description>

    <dependencies>
        <dependency>
            <groupId>cn.iocoder.agentscope</groupId>
            <artifactId>agentscope-core</artifactId>
        </dependency>

        <!-- Shared test fixtures from agentscope-core (MockModel, MockToolkit, etc.). -->
        <dependency>
            <groupId>cn.iocoder.agentscope</groupId>
            <artifactId>agentscope-core</artifactId>
            <version>${revision}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>

        <!-- Exercise AG-UI resume conversion against the real HarnessAgent. -->
        <dependency>
            <groupId>cn.iocoder.agentscope</groupId>
            <artifactId>agentscope-extensions-agui</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- YAML parsing for subagent config -->
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>

        <!-- Commons Compress for secure tar archive extraction in sandbox -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-compress</artifactId>
            <version>1.27.1</version>
        </dependency>

        <!-- SQLite for best-effort local workspace index -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.47.1.0</version>
        </dependency>
    </dependencies>
