<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.iocoder.agentscope</groupId>
        <artifactId>agentscope-extensions</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>agentscope-spring-boot-starters</artifactId>
    <name>AgentScope Java - Spring Boot Starters</name>
    <description>Spring Boot starters for integrating AgentScope Java</description>
    <packaging>pom</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>2.7.18</spring-boot.version>
        <maven.deploy.skip>false</maven.deploy.skip>
    </properties>

    <modules>
        <module>agentscope-admin-spring-boot-starter</module>
        <module>agentscope-spring-boot-starter</module>
        <module>agentscope-dashscope-spring-boot-starter</module>
        <module>agentscope-openai-spring-boot-starter</module>
        <module>agentscope-ollama-spring-boot-starter</module>
        <module>agentscope-anthropic-spring-boot-starter</module>
        <module>agentscope-gemini-spring-boot-starter</module>
    <module>agentscope-openai-official-spring-boot-starter</module><module>agentscope-agui-spring-boot-starter</module><module>agentscope-chat-completions-web-starter</module><module>agentscope-jev-spring-boot-starter</module><module>agentscope-openai-decisions-spring-boot-starter</module>
        <module>agentscope-a2a-spring-boot-starter</module>
        <module>agentscope-nacos-spring-boot-starter</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>cn.iocoder.agentscope</groupId>
                <artifactId>agentscope-dependencies-bom</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
                <configuration>
                    <release>${java.version}</release>
                    <compilerArgs>
                        <compilerArg>-parameters</compilerArg>
                    </compilerArgs>
                    <debug>true</debug>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                            <version>${spring-boot.version}</version>
                        </path>
                    <path><groupId>com.github.bsideup.jabel</groupId><artifactId>jabel-javac-plugin</artifactId><version>1.0.0</version></path></annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
