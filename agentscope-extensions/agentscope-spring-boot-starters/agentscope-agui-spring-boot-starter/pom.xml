<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.iocoder.agentscope</groupId>
        <artifactId>agentscope-spring-boot-starters</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>agentscope-agui-spring-boot-starter</artifactId>
    <name>AgentScope Java AG-UI - Spring Boot Starter</name>
    <description>Spring Boot starter for integrating AgentScope Java AG-UI (supports both MVC and WebFlux)</description>

    <properties>
        <maven.deploy.skip>false</maven.deploy.skip>
    </properties>

    <dependencies>
        <!-- AgentScope Core -->
        <dependency>
            <groupId>cn.iocoder.agentscope</groupId>
            <artifactId>agentscope-core</artifactId>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>

        <!-- AG-UI Core -->
        <dependency>
            <groupId>cn.iocoder.agentscope</groupId>
            <artifactId>agentscope-extensions-agui</artifactId>
        </dependency>

        <!-- AgentScope Spring Boot Starter (includes core and autoconfigure) -->
        <dependency>
            <groupId>cn.iocoder.agentscope</groupId>
            <artifactId>agentscope-spring-boot-starter</artifactId>
        </dependency>

        <!-- Spring Web MVC (optional, for servlet-based applications) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring WebFlux (optional, for reactive applications) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Configuration properties metadata processor -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>cn.iocoder.agentscope</groupId>
            <artifactId>agentscope-extensions-model-dashscope</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

