    <name>AgentScope Java - Extensions - MySQL</name>
    <description>MySQL/JDBC-backed distributed implementations for AgentStateStore and BaseStore. Provides MysqlDistributedStore for one-line distributed configuration.</description>
    <artifactId>agentscope-extensions-mysql</artifactId>

    <dependencies>
        <dependency>
            <groupId>cn.iocoder.agentscope</groupId>
            <artifactId>agentscope-core</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>cn.iocoder.agentscope</groupId>
            <artifactId>agentscope-harness</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- SQLite for local/test JdbcStore dialect -->
